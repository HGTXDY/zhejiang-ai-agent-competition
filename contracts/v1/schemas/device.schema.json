{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "device.schema.json",
  "title": "CookFlow Device Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operator_count", "devices"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operator_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "target_ready_at": {"type": ["string", "null"], "format": "date-time"},
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "device_type", "capacity_units", "capabilities"],
        "properties": {
          "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "device_type": {
            "enum": ["range_hood", "stove", "steamer", "oven", "refrigerator", "dishwasher", "water_purifier"]
          },
          "capacity_units": {"type": "integer", "minimum": 1},
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "temperature_min_c": {"type": ["integer", "null"], "minimum": -50, "maximum": 500},
              "temperature_max_c": {"type": ["integer", "null"], "minimum": -50, "maximum": 500}
            }
          },
          "available": {"type": "boolean", "default": true}
        }
      }
    }
  }
}
