{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schedule-response.schema.json",
  "title": "CookFlow Schedule Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "schedule_id",
    "solver",
    "metrics",
    "tasks",
    "validation",
    "timings_ms",
    "notifications"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "duration_ms"
      ],
      "properties": {
        "status": {
          "enum": [
            "OPTIMAL",
            "FEASIBLE",
            "INFEASIBLE",
            "UNKNOWN"
          ]
        },
        "objective_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "best_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "gap": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "makespan_sec",
        "finish_spread_sec",
        "max_continuous_manual_sec",
        "device_conflicts",
        "dependency_violations",
        "target_delay_sec"
      ],
      "properties": {
        "makespan_sec": {
          "type": "integer",
          "minimum": 0
        },
        "finish_spread_sec": {
          "type": "integer",
          "minimum": 0
        },
        "max_continuous_manual_sec": {
          "type": "integer",
          "minimum": 0
        },
        "device_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_violations": {
          "type": "integer",
          "minimum": 0
        },
        "target_delay_sec": {
          "type": "integer",
          "minimum": 0
        },
        "serial_baseline_sec": {
          "type": "integer",
          "minimum": 0
        },
        "makespan_compression_ratio": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "dish_id",
          "start_offset_sec",
          "end_offset_sec",
          "assigned_resources",
          "status",
          "locked",
          "notification_points"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "dish_id": {
            "type": "string",
            "minLength": 1
          },
          "start_offset_sec": {
            "type": "integer",
            "minimum": 0
          },
          "end_offset_sec": {
            "type": "integer",
            "minimum": 1
          },
          "assigned_resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PENDING",
              "LOCKED",
              "RUNNING",
              "DELAYED",
              "COMPLETED",
              "EXCEPTION",
              "CANCELLED"
            ]
          },
          "locked": {
            "type": "boolean"
          },
          "notification_points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "offset_sec",
                "message"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "start",
                    "prepare",
                    "manual",
                    "complete",
                    "exception"
                  ]
                },
                "offset_sec": {
                  "type": "integer",
                  "minimum": 0
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "errors"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parse",
        "validation",
        "solve",
        "notification",
        "total"
      ],
      "properties": {
        "parse": {
          "type": "integer",
          "minimum": 0
        },
        "validation": {
          "type": "integer",
          "minimum": 0
        },
        "solve": {
          "type": "integer",
          "minimum": 0
        },
        "notification": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "$ref": "notification.schema.json"
      }
    }
  }
}
