{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "CookFlow Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "name", "steps_text"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "ingredients": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "steps_text": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {"type": ["string", "null"], "maxLength": 500}
  }
}
