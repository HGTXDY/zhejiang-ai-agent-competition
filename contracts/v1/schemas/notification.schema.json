{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notification.schema.json",
  "title": "CookFlow Notification",
  "type": "object",
  "additionalProperties": false,
  "required": ["notification_id", "level", "type", "message", "created_at"],
  "properties": {
    "notification_id": {"type": "string", "minLength": 1},
    "level": {"enum": ["info", "warning", "error"]},
    "type": {"enum": ["task_due", "task_delayed", "device_conflict", "schedule_updated", "infeasible"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "task_id": {"type": ["string", "null"]},
    "device_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
