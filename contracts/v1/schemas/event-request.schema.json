{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-request.schema.json",
  "title": "CookFlow Execution Event Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "schedule_id", "event_type", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "schedule_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["TASK_COMPLETED", "TASK_DELAYED", "DISH_ADDED", "DEVICE_UNAVAILABLE"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "TASK_COMPLETED"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["task_id"], "properties": {"task_id": {"type": "string", "minLength": 1}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "TASK_DELAYED"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["task_id", "delay_sec"], "properties": {"task_id": {"type": "string", "minLength": 1}, "delay_sec": {"type": "integer", "minimum": 1}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "DEVICE_UNAVAILABLE"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["device_id"], "properties": {"device_id": {"type": "string", "minLength": 1}, "expected_recovery_at": {"type": ["string", "null"], "format": "date-time"}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "DISH_ADDED"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["tasks"], "properties": {"tasks": {"type": "array", "minItems": 1, "items": {"$ref": "task.schema.json"}}}}}}
    }
  ]
}
